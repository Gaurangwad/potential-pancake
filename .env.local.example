# Ooze environment — copy to .env.local and fill in.
# The app runs WITHOUT any keys (heuristic categoriser, dev-OTP login,
# simulated payment, local JSON store, AA + email sandboxes). Add keys to
# switch each piece to the real provider.

# --- Categorisation ---
# Server-side only. Sharpens merchant recognition on messy narrations.
ANTHROPIC_API_KEY=

# --- Auth ---
# Signs the session cookie. Use a long random string in production.
AUTH_SECRET=

# Real OTP SMS (India). If unset → dev-OTP mode (code shown on screen).
# The demo number 9800000000 is always free with a fixed code.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# --- Razorpay (TEST keys) ---
# If unset → a clearly-marked SIMULATED payment. Set keys for real checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Supabase (optional persistence) ---
# If set, users + audit snapshots persist here instead of .data/ooze.json.
# Run supabase-schema.sql first. Service-role key is SERVER-ONLY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Account Aggregator autofetch (TSP: Setu / Finvu / Anumati) ---
# If unset → AA sandbox (synthetic linked accounts + transactions).
# Requires an FIU/TSP partnership — a regulated onboarding.
SETU_AA_CLIENT_ID=
SETU_AA_CLIENT_SECRET=

# --- Gmail scan for overhead/dues (Google OAuth) ---
# If unset → email sandbox. Restricted Gmail scopes need a verified Google app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- FX rates (optional) ---
# Live rates default to the free key-less open.er-api. Point FX_RATES_URL at a
# keyed endpoint returning { rates: { USD: <per-INR>, ... } } for higher limits.
FX_RATES_URL=
# Override individual fallback rates (used only if the live fetch fails):
FX_RATES_JSON=

# --- Notion reminders (optional) ---
# Pushes renewal/due reminders into a Notion DB with "Name" (title) + "Date".
NOTION_TOKEN=
NOTION_DATABASE_ID=

# --- WhatsApp reminders (optional) ---
# India-first retention. Needs an approved WhatsApp Business template.
MSG91_WHATSAPP_AUTHKEY=
GUPSHUP_API_KEY=
